# KDH-CAD external assets. Copy to a local untracked file and adapt paths.
# Every path is relative to the repository root; ../ is supported.
KDH_CAD_ASSET_ROOT=assets
KDH_CAD_MODEL_ROOT=models
KDH_CAD_RESULTS_ROOT=results

# Common paper assets derived from KDH_CAD_ASSET_ROOT.
KDH_CAD_TMCAD_SPLITS=${KDH_CAD_ASSET_ROOT}/json_newPath
KDH_CAD_FABWAVE_SPLITS=${KDH_CAD_ASSET_ROOT}/data/Febwave_jsons_merged
KDH_CAD_TMCAD_EMBEDDINGS=${KDH_CAD_ASSET_ROOT}/data/test0122
KDH_CAD_FABWAVE_EMBEDDINGS=${KDH_CAD_ASSET_ROOT}/data/FabwaveAnchor
KDH_CAD_QWEN_PATH=${KDH_CAD_MODEL_ROOT}/qwen3vl2b

# Downloaded test-only checkpoints. Keep one selected checkpoint per dataset.
KDH_CAD_TMCAD_CKPT=${KDH_CAD_ASSET_ROOT}/kdhcad_tmcad_best.pth
KDH_CAD_TMCAD_CLASSIFIER_MODE=cross_attn
KDH_CAD_FABWAVE_CKPT=${KDH_CAD_ASSET_ROOT}/kdhcad_fabwave_best.pth
KDH_CAD_FABWAVE_CLASSIFIER_MODE=cross_attn
KDH_CAD_FABWAVE_SPLIT_DIR=${KDH_CAD_FABWAVE_SPLITS}/tail_50
